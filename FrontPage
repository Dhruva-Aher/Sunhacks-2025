import React, { useState, useEffect } from 'react';
import { 
  Calendar, 
  CheckSquare, 
  Mail, 
  FileText, 
  MessageSquare, 
  Brain, 
  Plus, 
  Send, 
  Clock, 
  User,
  Settings,
  Home,
  MoreHorizontal,
  X,
  Check,
  Edit3,
  Paperclip,
  Smile,
  Eye,
  EyeOff,
  Lock
} from 'lucide-react';

const Dashboard = () => {
  const [activeSection, setActiveSection] = useState('Dashboard');
  const [currentTask, setCurrentTask] = useState('idle');
  const [todos, setTodos] = useState([
    { id: 1, text: 'Review quarterly reports', completed: false, priority: 'high' },
    { id: 2, text: 'Schedule team meeting', completed: true, priority: 'medium' },
    { id: 3, text: 'Update project documentation', completed: false, priority: 'low' },
    { id: 4, text: 'Prepare presentation slides', completed: false, priority: 'high' }
  ]);
  const [newTodo, setNewTodo] = useState('');
  const [emailData, setEmailData] = useState({
    to: '',
    subject: '',
    body: ''
  });

  const [events] = useState([
    { id: 1, title: 'Team Standup', time: '9:00 AM', date: 'Today', type: 'meeting', duration: 30 },
    { id: 2, title: 'Client Presentation', time: '2:00 PM', date: 'Today', type: 'presentation', duration: 60 },
    { id: 3, title: 'Code Review', time: '11:00 AM', date: 'Today', type: 'meeting', duration: 45 },
    { id: 4, title: 'Lunch Break', time: '12:30 PM', date: 'Today', type: 'break', duration: 60 },
    { id: 5, title: 'Project Review', time: '10:00 AM', date: 'Tomorrow', type: 'meeting', duration: 30 },
    { id: 6, title: 'Design Workshop', time: '3:00 PM', date: 'Tomorrow', type: 'workshop', duration: 90 }
  ]);

  const sidebarItems = [
    { icon: Home, label: 'Dashboard', id: 'Dashboard' },
    { icon: Brain, label: 'AI Assistant', id: 'AI Assistant' },
    { icon: Calendar, label: 'Calendar', id: 'Calendar' },
    { icon: CheckSquare, label: 'Tasks', id: 'Tasks' },
    { icon: Mail, label: 'Messages', id: 'Messages' },
    { icon: Settings, label: 'Settings', id: 'Settings' }
  ];

  // Calculate daily busyness and availability
  const calculateDayStats = () => {
    const todayEvents = events.filter(event => event.date === 'Today');
    const incompleteTasks = todos.filter(todo => !todo.completed);
    
    const totalMeetingTime = todayEvents.reduce((acc, event) => acc + event.duration, 0);
    const workingHours = 540;
    const busyPercentage = Math.min((totalMeetingTime / workingHours) * 100, 100);
    
    const timeSlots = [
      { time: '9:00-10:00 AM', available: !todayEvents.some(e => e.time === '9:00 AM') },
      { time: '10:00-11:00 AM', available: !todayEvents.some(e => e.time === '10:00 AM') },
      { time: '11:00 AM-12:00 PM', available: !todayEvents.some(e => e.time === '11:00 AM') },
      { time: '1:00-2:00 PM', available: !todayEvents.some(e => e.time === '1:00 PM') },
      { time: '3:00-4:00 PM', available: !todayEvents.some(e => e.time === '3:00 PM') },
      { time: '4:00-5:00 PM', available: !todayEvents.some(e => e.time === '4:00 PM') },
      { time: '5:00-6:00 PM', available: !todayEvents.some(e => e.time === '5:00 PM') }
    ];
    
    const availableSlots = timeSlots.filter(slot => slot.available);
    
    return {
      busyPercentage: Math.round(busyPercentage),
      totalMeetings: todayEvents.length,
      pendingTasks: incompleteTasks.length,
      availableSlots,
      nextAvailable: availableSlots[0]?.time || 'No slots available'
    };
  };

  const dayStats = calculateDayStats();

  const addTodo = () => {
    if (newTodo.trim()) {
      setTodos([...todos, {
        id: Date.now(),
        text: newTodo,
        completed: false,
        priority: 'medium'
      }]);
      setNewTodo('');
    }
  };

  const toggleTodo = (id) => {
    setTodos(todos.map(todo => 
      todo.id === id ? { ...todo, completed: !todo.completed } : todo
    ));
  };

  const deleteTodo = (id) => {
    setTodos(todos.filter(todo => todo.id !== id));
  };

  const startEmailTask = () => {
    setCurrentTask('email');
    setEmailData({ to: '', subject: '', body: '' });
  };

  const AIAssistantDisplay = () => {
    switch(currentTask) {
      case 'email':
        return (
          <div className="h-full bg-white rounded-2xl shadow-lg overflow-hidden">
            <div className="bg-gray-50 border-b px-6 py-4 flex items-center justify-between">
              <h3 className="text-lg font-semibold text-gray-800">Compose Email</h3>
              <button 
                onClick={() => setCurrentTask('idle')}
                className="p-2 hover:bg-gray-200 rounded-full transition-colors"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <div className="p-6 space-y-4">
              <div className="flex items-center space-x-3">
                <span className="text-sm font-medium text-gray-600 w-12">To:</span>
                <input
                  type="email"
                  value={emailData.to}
                  onChange={(e) => setEmailData({...emailData, to: e.target.value})}
                  placeholder="Recipients"
                  className="flex-1 px-3 py-2 border-b border-gray-200 focus:border-blue-500 focus:outline-none"
                />
              </div>

              <div className="flex items-center space-x-3">
                <span className="text-sm font-medium text-gray-600 w-12">Subject:</span>
                <input
                  type="text"
                  value={emailData.subject}
                  onChange={(e) => setEmailData({...emailData, subject: e.target.value})}
                  placeholder="Subject"
                  className="flex-1 px-3 py-2 border-b border-gray-200 focus:border-blue-500 focus:outline-none"
                />
              </div>

              <div className="mt-6">
                <textarea
                  value={emailData.body}
                  onChange={(e) => setEmailData({...emailData, body: e.target.value})}
                  placeholder="Compose your email..."
                  rows={12}
                  className="w-full p-4 border border-gray-200 rounded-lg resize-none focus:border-blue-500 focus:outline-none"
                />
              </div>

              <div className="flex items-center justify-between pt-4 border-t">
                <div className="flex items-center space-x-3">
                  <button className="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg flex items-center space-x-2 transition-colors">
                    <Send className="w-4 h-4" />
                    <span>Send</span>
                  </button>
                  <button className="p-2 hover:bg-gray-100 rounded-full transition-colors">
                    <Paperclip className="w-5 h-5 text-gray-600" />
                  </button>
                  <button className="p-2 hover:bg-gray-100 rounded-full transition-colors">
                    <Smile className="w-5 h-5 text-gray-600" />
                  </button>
                </div>
                <button className="text-sm text-gray-500 hover:text-gray-700 transition-colors">
                  Save Draft
                </button>
              </div>
            </div>
          </div>
        );

      case 'document':
        return (
          <div className="h-full bg-white rounded-2xl shadow-lg p-6">
            <div className="flex items-center justify-between mb-6">
              <h3 className="text-lg font-semibold text-gray-800">Document Editor</h3>
              <button onClick={() => setCurrentTask('idle')} className="p-2 hover:bg-gray-100 rounded-full">
                <X className="w-5 h-5" />
              </button>
            </div>
            <div className="bg-gray-50 rounded-lg p-6 h-96">
              <div className="animate-pulse">
                <div className="h-4 bg-gray-300 rounded w-3/4 mb-4"></div>
                <div className="h-4 bg-gray-300 rounded w-1/2 mb-4"></div>
                <div className="h-4 bg-gray-300 rounded w-5/6 mb-4"></div>
                <div className="h-4 bg-gray-300 rounded w-2/3"></div>
              </div>
              <p className="text-center text-gray-500 mt-8">AI is generating document...</p>
            </div>
          </div>
        );

      default:
        return (
          <div className="h-full bg-gradient-to-br from-purple-50 to-blue-50 rounded-2xl shadow-lg flex items-center justify-center">
            <div className="text-center">
              <div className="w-20 h-20 bg-gradient-to-r from-purple-500 to-blue-500 rounded-full flex items-center justify-center mb-6 mx-auto">
                <Brain className="w-10 h-10 text-white" />
              </div>
              <h3 className="text-xl font-semibold text-gray-800 mb-2">AI Assistant Ready</h3>
              <p className="text-gray-600 mb-6">Choose a task to get started</p>
              <div className="space-y-3">
                <button
                  onClick={startEmailTask}
                  className="w-full bg-white hover:bg-gray-50 p-4 rounded-xl shadow-sm border flex items-center space-x-3 transition-colors"
                >
                  <Mail className="w-5 h-5 text-purple-500" />
                  <span>Compose Email</span>
                </button>
                <button
                  onClick={() => setCurrentTask('document')}
                  className="w-full bg-white hover:bg-gray-50 p-4 rounded-xl shadow-sm border flex items-center space-x-3 transition-colors"
                >
                  <FileText className="w-5 h-5 text-blue-500" />
                  <span>Create Document</span>
                </button>
                <button className="w-full bg-white hover:bg-gray-50 p-4 rounded-xl shadow-sm border flex items-center space-x-3 transition-colors">
                  <MessageSquare className="w-5 h-5 text-green-500" />
                  <span>Chat Assistant</span>
                </button>
              </div>
            </div>
          </div>
        );
    }
  };

  const renderMainContent = () => {
    switch(activeSection) {
      case 'Dashboard':
        return <AIAssistantDisplay />;
        
      case 'AI Assistant':
        return (
          <div className="h-full bg-gradient-to-br from-purple-50 to-blue-50 rounded-2xl shadow-lg p-8">
            <div className="text-center">
              <div className="w-24 h-24 bg-gradient-to-r from-purple-500 to-blue-500 rounded-full flex items-center justify-center mb-6 mx-auto animate-pulse">
                <Brain className="w-12 h-12 text-white" />
              </div>
              <h2 className="text-2xl font-bold text-gray-800 mb-4">AI Assistant Hub</h2>
              <p className="text-gray-600 mb-8">Your intelligent companion for productivity</p>
              
              <div className="grid grid-cols-2 gap-4 max-w-md mx-auto">
                <button
                  onClick={startEmailTask}
                  className="bg-white hover:bg-gray-50 p-6 rounded-xl shadow-sm border flex flex-col items-center space-y-3 transition-all duration-300 hover:shadow-lg hover:-translate-y-1"
                >
                  <Mail className="w-8 h-8 text-purple-500" />
                  <span className="font-medium">Email Assistant</span>
                </button>
                <button
                  onClick={() => setCurrentTask('document')}
                  className="bg-white hover:bg-gray-50 p-6 rounded-xl shadow-sm border flex flex-col items-center space-y-3 transition-all duration-300 hover:shadow-lg hover:-translate-y-1"
                >
                  <FileText className="w-8 h-8 text-blue-500" />
                  <span className="font-medium">Document Writer</span>
                </button>
                <button className="bg-white hover:bg-gray-50 p-6 rounded-xl shadow-sm border flex flex-col items-center space-y-3 transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
                  <MessageSquare className="w-8 h-8 text-green-500" />
                  <span className="font-medium">Chat Assistant</span>
                </button>
                <button className="bg-white hover:bg-gray-50 p-6 rounded-xl shadow-sm border flex flex-col items-center space-y-3 transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
                  <Calendar className="w-8 h-8 text-orange-500" />
                  <span className="font-medium">Schedule Helper</span>
                </button>
              </div>
            </div>
          </div>
        );

      case 'Tasks':
        return (
          <div className="h-full bg-white rounded-2xl shadow-lg p-6">
            <div className="flex items-center justify-between mb-6">
              <h2 className="text-2xl font-bold text-gray-800">Task Manager</h2>
              <div className="flex items-center space-x-2">
                <span className="text-sm text-gray-500">{todos.filter(t => !t.completed).length} pending</span>
              </div>
            </div>

            <div className="flex space-x-3 mb-6">
              <input
                type="text"
                value={newTodo}
                onChange={(e) => setNewTodo(e.target.value)}
                placeholder="What needs to be done?"
                className="flex-1 px-4 py-3 border border-gray-200 rounded-xl focus:border-purple-500 focus:outline-none transition-colors"
                onKeyPress={(e) => e.key === 'Enter' && addTodo()}
              />
              <button
                onClick={addTodo}
                className="bg-purple-500 hover:bg-purple-600 text-white px-6 py-3 rounded-xl transition-colors flex items-center space-x-2"
              >
                <Plus className="w-4 h-4" />
                <span>Add Task</span>
              </button>
            </div>

            <div className="space-y-3 max-h-96 overflow-y-auto">
              {todos.map(todo => (
                <div key={todo.id} className="bg-gray-50 p-4 rounded-xl hover:shadow-sm transition-all duration-200 group">
                  <div className="flex items-center space-x-4">
                    <button
                      onClick={() => toggleTodo(todo.id)}
                      className={`w-6 h-6 rounded-full border-2 flex items-center justify-center transition-all duration-200 ${
                        todo.completed 
                          ? 'bg-green-500 border-green-500 text-white' 
                          : 'border-gray-300 hover:border-purple-500 group-hover:scale-110'
                      }`}
                    >
                      {todo.completed && <Check className="w-4 h-4" />}
                    </button>
                    <div className="flex-1">
                      <p className={`text-base ${
                        todo.completed ? 'line-through text-gray-500' : 'text-gray-800'
                      }`}>
                        {todo.text}
                      </p>
                      <div className="flex items-center space-x-2 mt-1">
                        <div className={`w-3 h-3 rounded-full ${
                          todo.priority === 'high' ? 'bg-red-400' :
                          todo.priority === 'medium' ? 'bg-yellow-400' :
                          'bg-green-400'
                        }`}></div>
                        <span className="text-xs text-gray-500 capitalize">{todo.priority} priority</span>
                      </div>
                    </div>
                    <button
                      onClick={() => deleteTodo(todo.id)}
                      className="opacity-0 group-hover:opacity-100 p-2 text-red-500 hover:bg-red-50 rounded-lg transition-all duration-200"
                    >
                      <X className="w-4 h-4" />
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        );

      default:
        return <AIAssistantDisplay />;
    }
  };

  return (
    <div className="min-h-screen bg-gray-50 flex">
      {/* Sidebar */}
      <div className="w-64 bg-white shadow-lg">
        <div className="p-6 border-b">
          <div className="flex items-center space-x-3">
            <div className="w-10 h-10 bg-gradient-to-r from-purple-500 to-blue-500 rounded-xl flex items-center justify-center">
              <Brain className="w-6 h-6 text-white" />
            </div>
            <div>
              <h1 className="text-lg font-bold text-gray-800">AI Dashboard</h1>
              <p className="text-sm text-gray-500">Smart Workspace</p>
            </div>
          </div>
        </div>

        <nav className="p-4 space-y-2">
          {sidebarItems.map((item, index) => (
            <button
              key={index}
              onClick={() => setActiveSection(item.id)}
              className={`w-full flex items-center space-x-3 p-3 rounded-xl transition-all duration-300 transform hover:scale-105 ${
                activeSection === item.id
                  ? 'bg-gradient-to-r from-purple-500 to-blue-500 text-white shadow-lg' 
                  : 'text-gray-700 hover:bg-gray-100 hover:shadow-md'
              }`}
            >
              <item.icon className={`w-5 h-5 transition-transform duration-300 ${
                activeSection === item.id ? 'scale-110' : ''
              }`} />
              <span className="font-medium">{item.label}</span>
              {activeSection === item.id && (
                <div className="ml-auto w-2 h-2 bg-white rounded-full animate-pulse" />
              )}
            </button>
          ))}
        </nav>

        <div className="absolute bottom-6 left-4 right-4">
          <div className="bg-gradient-to-r from-purple-100 to-blue-100 p-4 rounded-xl">
            <div className="flex items-center space-x-3 mb-2">
              <User className="w-8 h-8 text-purple-600" />
              <div>
                <p className="font-semibold text-gray-800">John Doe</p>
                <p className="text-sm text-gray-600">Premium User</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Main Content */}
      <div className="flex-1 p-6">
        <div className="transition-all duration-500 ease-in-out">
          {renderMainContent()}
        </div>
      </div>

      {/* Right Panel - Only show for Dashboard */}
      {activeSection === 'Dashboard' && (
        <div className="w-80 p-6 space-y-6">
          {/* Top Row - Tasks and Schedule Side by Side */}
          <div className="grid grid-cols-2 gap-4">
            {/* Todo Tasks - Left */}
            <div className="bg-white rounded-2xl shadow-lg p-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-md font-semibold text-gray-800">Tasks</h3>
                <CheckSquare className="w-4 h-4 text-gray-400" />
              </div>

              {/* Add Todo */}
              <div className="flex space-x-1 mb-3">
                <input
                  type="text"
                  value={newTodo}
                  onChange={(e) => setNewTodo(e.target.value)}
                  placeholder="Add task..."
                  className="flex-1 px-2 py-1 text-xs border border-gray-200 rounded focus:border-purple-500 focus:outline-none"
                  onKeyPress={(e) => e.key === 'Enter' && addTodo()}
                />
                <button
                  onClick={addTodo}
                  className="p-1 bg-purple-500 hover:bg-purple-600 text-white rounded transition-colors"
                >
                  <Plus className="w-3 h-3" />
                </button>
              </div>

              {/* Todo List */}
              <div className="space-y-1 max-h-32 overflow-y-auto">
                {todos.slice(0, 4).map(todo => (
                  <div key={todo.id} className="flex items-center space-x-2 p-1 hover:bg-gray-50 rounded group transition-colors">
                    <button
                      onClick={() => toggleTodo(todo.id)}
                      className={`w-3 h-3 rounded border flex items-center justify-center transition-colors ${
                        todo.completed 
                          ? 'bg-green-500 border-green-500 text-white' 
                          : 'border-gray-300 hover:border-purple-500'
                      }`}
                    >
                      {todo.completed && <Check className="w-2 h-2" />}
                    </button>
                    <span className={`flex-1 text-xs ${
                      todo.completed ? 'line-through text-gray-500' : 'text-gray-800'
                    }`}>
                      {todo.text.length > 20 ? todo.text.substring(0, 20) + '...' : todo.text}
                    </span>
                    <div className={`w-1.5 h-1.5 rounded-full ${
                      todo.priority === 'high' ? 'bg-red-400' :
                      todo.priority === 'medium' ? 'bg-yellow-400' :
                      'bg-green-400'
                    }`}></div>
                    <button
                      onClick={() => deleteTodo(todo.id)}
                      className="opacity-0 group-hover:opacity-100 p-0.5 text-red-500 hover:bg-red-50 rounded transition-all"
                    >
                      <X className="w-2 h-2" />
                    </button>
                  </div>
                ))}
              </div>
              {todos.length > 4 && (
                <div className="text-xs text-gray-500 text-center mt-2">
                  <button 
                    onClick={() => setActiveSection('Tasks')}
                    className="hover:text-purple-500 transition-colors"
                  >
                    +{todos.length - 4} more tasks →
                  </button>
                </div>
              )}
            </div>

            {/* Daily Status Progress Circle - Right */}
            <div className="bg-white rounded-2xl shadow-lg p-4">
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-md font-semibold text-gray-800">Today</h3>
                <Clock className="w-4 h-4 text-gray-400" />
              </div>
              
              <div className="flex flex-col items-center space-y-2">
                {/* Progress Circle */}
                <div className="relative">
                  <svg className="w-16 h-16 transform -rotate-90" viewBox="0 0 36 36">
                    {/* Background circle */}
                    <path
                      className="stroke-gray-200"
                      strokeWidth="3"
                      fill="transparent"
                      d="M18 2.0845
                        a 15.9155 15.9155 0 0 1 0 31.831
                        a 15.9155 15.9155 0 0 1 0 -31.831"
                    />
                    {/* Progress circle */}
                    <path
                      className={`${dayStats.busyPercentage > 75 ? 'stroke-red-500' : 
                                dayStats.busyPercentage > 50 ? 'stroke-yellow-500' : 
                                'stroke-green-500'}`}
                      strokeWidth="3"
                      strokeLinecap="round"
                      fill="transparent"
                      strokeDasharray={`${dayStats.busyPercentage}, 100`}
                      d="M18 2.0845
                        a 15.9155 15.9155 0 0 1 0 31.831
                        a 15.9155 15.9155 0 0 1 0 -31.831"
                    />
                  </svg>
                  {/* Center text */}
                  <div className="absolute inset-0 flex items-center justify-center">
                    <span className={`text-xs font-bold ${
                      dayStats.busyPercentage > 75 ? 'text-red-500' : 
                      dayStats.busyPercentage > 50 ? 'text-yellow-500' : 
                      'text-green-500'
                    }`}>
                      {dayStats.busyPercentage}%
                    </span>
                  </div>
                </div>
                
                {/* Compact Stats */}
                <div className="text-center space-y-1">
                  <div className="flex justify-center space-x-3 text-xs">
                    <span className="text-gray-600">{dayStats.totalMeetings} meetings</span>
                    <span className="text-gray-600">{dayStats.pendingTasks} tasks</span>
                  </div>
                  <div className="text-xs text-green-600 font-medium">
                    Next: {dayStats.nextAvailable.split('-')[0]}
                  </div>
                </div>
                
                {/* Status Badge */}
                <span className={`inline-flex items-center px-2 py-1 rounded-full text-xs font-medium ${
                  dayStats.busyPercentage > 75 ? 'bg-red-100 text-red-800' :
                  dayStats.busyPercentage > 50 ? 'bg-yellow-100 text-yellow-800' :
                  'bg-green-100 text-green-800'
                }`}>
                  {dayStats.busyPercentage > 75 ? '🔥 Busy' :
                   dayStats.busyPercentage > 50 ? '⚡ Moderate' :
                   '✨ Light'}
                </span>
              </div>
            </div>
          </div>

          {/* Calendar Events - Full Width */}
          <div className="bg-white rounded-2xl shadow-lg p-6">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-lg font-semibold text-gray-800">Upcoming Events</h3>
              <Calendar className="w-5 h-5 text-gray-400" />
            </div>
            <div className="space-y-3">
              {events.map(event => (
                <div key={event.id} className="flex items-center space-x-3 p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                  <div className={`w-3 h-3 rounded-full ${
                    event.type === 'meeting' ? 'bg-blue-500' :
                    event.type === 'presentation' ? 'bg-purple-500' :
                    event.type === 'break' ? 'bg-orange-500' :
                    'bg-green-500'
                  }`}></div>
                  <div className="flex-1">
                    <p className="font-medium text-gray-800 text-sm">{event.title}</p>
                    <p className="text-xs text-gray-500">{event.date} • {event.time}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default Dashboard;
